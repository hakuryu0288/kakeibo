# Supabase（必須）
# https://supabase.com のプロジェクト設定 > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# サーバー専用のキー（推奨）。設定すると、Supabase側でRLSを有効にしても動く。
# プロジェクト設定 > API の「service_role」キー。絶対に NEXT_PUBLIC_ を付けないこと
SUPABASE_SERVICE_ROLE_KEY=

# ログイン用のパスワード（サーバーだけで照合する。NEXT_PUBLIC_ を付けないこと）
# 4桁より長い数字にすると、総当たりに強くなる
APP_PASSWORD=0000
